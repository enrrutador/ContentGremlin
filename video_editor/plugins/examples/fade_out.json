{
  "id": "effect.fade_out",
  "name": "Fundido de salida",
  "version": "1.0.0",
  "category": "Efectos de video",
  "type": "effect",
  "description": "Fade out to black at the end of the clip",
  "params": {
    "duration": { "type": "number", "default": 1, "min": 0.1, "max": 10, "unit": "s" }
  },
  "ffmpeg": { "filter": "fade=t=out:st={start}:d={duration}" },
  "license": "MIT-compatible (FFmpeg filter)"
}
