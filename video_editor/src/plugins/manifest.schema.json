{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "category", "type"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "category": {"type": "string"},
    "type": {"type": "string", "enum": ["filter", "tool", "effect", "transition", "title"]},
    "description": {"type": "string"},
    "params": {"type": "object"},
    "ffmpeg": {"type": "object"},
    "license": {"type": "string"}
  }
}
