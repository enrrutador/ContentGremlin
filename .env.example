# ContentGremlin Environment Variables
# Copy this file to .env and fill in the values you need.

# === Required: at least one LLM provider ===
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-2

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenRouter or other compatible
OPENROUTER_API_KEY=

# === Optional: YouTube Data API ===
# You can also configure this later from the web interface
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/token.json

# === Optional: TTS ===
ELEVENLABS_API_KEY=
OPENAI_TTS_VOICE=alloy

# === Application ===
HOST=0.0.0.0
PORT=8000
DEBUG=true
DEFAULT_MODE=supervised          # supervised | autonomous
