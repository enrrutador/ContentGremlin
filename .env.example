# ContentGremlin Environment Variables
# Copy to .env and fill values.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

XAI_API_KEY=
XAI_MODEL=grok-2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENROUTER_API_KEY=

YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/token.json

ELEVENLABS_API_KEY=
OPENAI_TTS_VOICE=alloy

HOST=0.0.0.0
PORT=8000
DEBUG=true
DEFAULT_MODE=supervised

# Cinematic mode (optional)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=dall-e-3
VIDEO_PROVIDER=none
# VIDEO_PROVIDER=generic_http
# VIDEO_API_URL=https://your-video-api.example/v1/generate
# VIDEO_API_KEY=
CINEMATIC_MAX_SCENES=12
CINEMATIC_DEFAULT_STYLE=cinematic, shallow depth of field, natural light, 35mm film still
