# ContentGremlin Environment Variables
# Copy to .env and fill values.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

XAI_API_KEY=
XAI_MODEL=grok-2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/token.json

ELEVENLABS_API_KEY=
OPENAI_TTS_VOICE=alloy
# Edge-TTS gratis sin key (tts_provider=edge en perfil). Voces: es-AR-TomasNeural,
# es-AR-ElenaNeural, es-ES-AlvaroNeural, es-MX-DaliaNeural, es-CL-CatalinaNeural...
EDGE_TTS_VOICE=es-AR-TomasNeural

HOST=127.0.0.1
PORT=8000
DEBUG=true
DEFAULT_MODE=supervised

# Cinematic mode. IMAGE_PROVIDER: pollinations (gratis, sin key, default),
# openai (DALL-E, pago) o none. El usuario elige.
IMAGE_PROVIDER=pollinations
OPENAI_IMAGE_MODEL=dall-e-3
VIDEO_PROVIDER=none
CINEMATIC_MAX_SCENES=12
CINEMATIC_DEFAULT_STYLE=cinematic, shallow depth of field, natural light, 35mm film still

# Stock B-roll (production engine)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional local royalty-free music library
MUSIC_LIBRARY_DIR=data/music
